<Window x:Class="StrataRisk.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StrataRisk — Equity Risk &amp; Liquidity Screener"
        Height="680" Width="1140"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="14" Padding="18" Margin="0,0,0,14">
            <Grid>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                    <TextBlock Text="StrataRisk Risk &amp; Balance Sheet Dashboard" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Multi-Layer Technical Trend, Cash-to-Debt &amp; Defensive Stress Test Engine" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRunScan" Content="▶ Run Risk Scan" Style="{StaticResource RoundedButton}" Click="BtnRunScan_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnOpenCharts" Content="📈 Open HTML Trend Charts" Style="{StaticResource RoundedButton}" Background="#10B981" IsEnabled="False" Click="BtnOpenCharts_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <Border Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TICKERS SCREENED" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTotalScreened" Text="0" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1E293B" CornerRadius="12" Padding="14" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="DEFENSIVE TIER COUNT" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtDefensiveCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1E293B" CornerRadius="12" Padding="14" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="LAST RUN TIMESTAMP" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtLastRun" Text="Not Run Yet" FontSize="16" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Data Grid Card -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="14" Padding="12">
            <DataGrid x:Name="GridResults"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="#1E293B"
                      Foreground="#F8FAFC"
                      RowBackground="#1E293B"
                      AlternatingRowBackground="#0F172A"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155"
                      HeadersVisibility="Column"
                      RowHeight="34">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#38BDF8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ticker" Binding="{Binding Symbol}" Width="80"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="Price ($)" Binding="{Binding CurrentPrice, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="50 EMA" Binding="{Binding Ema50, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="200 SMA" Binding="{Binding Sma200, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="Trend" Binding="{Binding TrendSignal}" Width="95"/>
                    <DataGridTextColumn Header="Cash/Debt" Binding="{Binding CashToDebt, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="FCF Yield %" Binding="{Binding FcfYieldPct, StringFormat=N2}" Width="95"/>
                    <DataGridTextColumn Header="Score" Binding="{Binding StressScore}" Width="70"/>
                    <DataGridTextColumn Header="Risk Tier" Binding="{Binding RiskTier}" Width="100"/>
                    <DataGridTextColumn Header="Flags" Binding="{Binding RiskFlagsDisplay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Handshake Status Bar -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="10" Padding="12,8" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="[READY] Click 'Run Risk Scan' to invoke Python screening engine." Foreground="#94A3B8" FontSize="12"/>
        </Border>
    </Grid>
</Window>
